<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <h1 class="text-center my-4">Restaurant List</h1>

      <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled">

        <% @restaurants.each do |restaurant| %>
          <%= link_to restaurant_path(restaurant.id), class: "text-decoration-none text-dark" do %>
            <li class="col">
              <div class='card h-100 shadow-sm'>
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">

                    <h5 class="card-title mb-0 me-auto">
                      <%= restaurant.name %>
                    </h5>
                  </div>
                  <p class="card-text text-muted mt-2">
                    <i class="bi bi-tag-fill me-1"></i> <%= restaurant.category.name %>
                  </p>
                  <p class="card-text">
                    <i class="bi bi-geo-alt-fill me-1"></i> <%= restaurant.address %>
                  </p>
                </div>
              </div>
            </li>
            <% end %>
        <% end %>
      </ul>

    </div>
  </div>
</div>
