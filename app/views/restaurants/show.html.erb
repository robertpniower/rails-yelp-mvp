<div class="container">
  <div class="card m-auto shadow-sm" style="width: 48rem;">
    <div class="card-body">
      <div class="row text-center mb-2">
        <h2 class="card-title">
          <%= @restaurant.name %>
        </h2>
      </div>
      <div class="row text-center mb-2">
        <div class="card-text mt-2 mb-4">
          <h3 class="text-muted">
            <%= @restaurant.category.name %>
          </h3>
        </div>
        <div class="card-text mt-2 mb-4">
          <h3 class="text-muted">
            <%= @restaurant.address %>
          </h3>
        </div>
        <div>
          <%= link_to 'Show Restaurants', restaurants_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
